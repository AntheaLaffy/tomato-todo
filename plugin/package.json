{
  "name": "dsh-plugin-tomato-todo",
  "version": "0.13.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "host-tool-specs.js",
    "skills.js",
    "link-skills.js",
    "link-skills.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets/personas/*",
    "skills",
    "!skills/*/references/local-*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "description": "番茄 Todo：DeepSeek Harness (DSH) 插件形态的专注与学习工具——番茄钟与专注保护、任务/课表/应试教育、本地资料库索引，数据全在本机。",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis-plugin",
    "pomodoro",
    "focus-timer",
    "task-management",
    "study-planner",
    "local-first",
    "typescript",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntheaLaffy/dsh-plugin-tomato-todo.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/AntheaLaffy/dsh-plugin-tomato-todo#readme",
  "bugs": {
    "url": "https://github.com/AntheaLaffy/dsh-plugin-tomato-todo/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
