{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomato Todo Plan v1 / v2 / v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "pomodoroMinutes",
    "projects",
    "tasks"
  ],
  "properties": {
    "format": {
      "const": "tomato-todo-plan"
    },
    "version": {
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "pomodoroMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "replace": {
      "type": "boolean"
    },
    "projects": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "templates": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "prints": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/print"
      }
    },
    "goals": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "habits": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/habit"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "appWhitelist": {
          "type": "array",
          "maxItems": 100,
          "description": "应用 ID 精确匹配；提供即启用该项目专属白名单并覆盖旧值，省略则不改动本机列表。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "description": "Rust additionally limits UTF-8 bytes to 50000."
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "subtasks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/subtask"
          }
        },
        "repeat": {
          "enum": [
            "none",
            "daily",
            "weekdays",
            "weekly"
          ],
          "default": "none"
        },
        "reminderTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "default": null
        },
        "focusMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 180,
          "default": null
        },
        "templateId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "goalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "habitId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recurring": {
          "type": "boolean",
          "default": false
        },
        "scrapMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080,
          "default": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "reminderTime"
            ],
            "properties": {
              "reminderTime": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "dueDate"
            ],
            "properties": {
              "dueDate": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "description": "Rust additionally limits UTF-8 bytes to 50000."
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "subtasks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/templateSubtask"
          }
        },
        "focusMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 180,
          "default": null
        },
        "goalId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "habitId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scrapMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080,
          "default": 0
        }
      }
    },
    "printing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "once"
            },
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "time": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "default": null
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "slots"
          ],
          "properties": {
            "kind": {
              "const": "calendar"
            },
            "slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 49,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dates"
                ],
                "properties": {
                  "dates": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 366,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                    "default": null
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "slots"
          ],
          "properties": {
            "kind": {
              "const": "weekly"
            },
            "slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 49,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "days"
                ],
                "properties": {
                  "days": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 7
                    }
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                    "default": null
                  }
                }
              }
            }
          }
        }
      ]
    },
    "print": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId"
      ],
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "habit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "nodes": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/nodeSpec"
          },
          "default": []
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shape",
        "printing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "printing": {
          "$ref": "#/$defs/printing"
        },
        "automatic": {
          "type": "boolean",
          "default": false
        },
        "printAheadDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90,
          "default": 7
        }
      }
    },
    "templateSubtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "nodeSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "direction",
        "at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "success",
            "failure",
            "check"
          ]
        },
        "direction": {
          "enum": [
            "head",
            "tail"
          ]
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "condition": {
          "enum": [
            "always",
            "completed",
            "incomplete"
          ],
          "default": "always"
        }
      }
    },
    "nodeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "requiredTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000,
          "default": 1
        },
        "confirmationRequired": {
          "type": "boolean",
          "default": false
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/nodeSignal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blockSuccess": {
          "enum": [
            "never",
            "always",
            "unpaired",
            "unfinishedTasks",
            "incomplete",
            "completed"
          ],
          "default": "never"
        },
        "blockFailure": {
          "enum": [
            "never",
            "always",
            "unpaired",
            "unfinishedTasks",
            "incomplete",
            "completed"
          ],
          "default": "never"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "reminderTime": {
                  "type": "null"
                },
                "focusMinutes": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "properties": {
          "templates": {
            "maxItems": 0
          },
          "prints": {
            "maxItems": 0
          },
          "goals": {
            "maxItems": 0
          },
          "habits": {
            "maxItems": 0
          },
          "tasks": {
            "items": {
              "properties": {
                "templateId": {
                  "type": "null"
                },
                "goalId": {
                  "type": "null"
                },
                "habitId": {
                  "type": "null"
                },
                "recurring": {
                  "const": false
                },
                "scrapMinutes": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [
              3,
              4
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "repeat": {
                  "const": "none"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [
              1,
              2,
              3
            ]
          }
        }
      },
      "then": {
        "properties": {
          "goals": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
