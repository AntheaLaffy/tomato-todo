{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomato Todo Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "pomodoroMinutes", "projects", "tasks"],
  "properties": {
    "format": {
      "const": "tomato-todo-plan"
    },
    "version": {
      "const": 1
    },
    "pomodoroMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "projects": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "color"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "appWhitelist": {
          "type": "array",
          "maxItems": 100,
          "description": "应用 ID 精确匹配；提供即启用该项目专属白名单并覆盖旧值，省略则不改动本机列表。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "description": "Rust additionally limits UTF-8 bytes to 50000."
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "subtasks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/subtask"
          }
        },
        "repeat": {
          "enum": ["none", "daily", "weekdays", "weekly"],
          "default": "none"
        }
      }
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    }
  }
}
