{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomato Todo Backup v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "maxItems": 500
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      },
      "maxItems": 500
    },
    "habits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/habit"
      },
      "maxItems": 500
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "maxItems": 50000
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "timer": {
      "$ref": "#/$defs/timer"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      },
      "maxItems": 200000
    },
    "lock": {
      "$ref": "#/$defs/lock"
    }
  },
  "required": [
    "version",
    "projects",
    "tasks",
    "settings",
    "timer",
    "sessions"
  ],
  "$defs": {
    "habit": {
      "type": "object",
      "required": ["id", "name", "slots"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "projectId": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "focusMinutes": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 180 },
            { "type": "null" }
          ]
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["days", "time"],
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "integer", "minimum": 1, "maximum": 7 }
              },
              "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
            }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "required": ["id", "name", "target", "unit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "target": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 10 },
        "measure": { "enum": ["count", "time"], "default": "count" },
        "dueDate": {
          "anyOf": [
            { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "appWhitelist": {
          "type": "array",
          "maxItems": 100,
          "description": "该项目启用的专属白名单，精确匹配，最多 100 个；专注该项目任务时替代通用白名单。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "notes",
        "priority",
        "estimate",
        "completed",
        "createdAt",
        "tags",
        "subtasks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "description": "Rust additionally limits UTF-8 bytes to 50000."
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "goalId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "habitId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "subtasks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/subtask"
          }
        },
        "repeat": {
          "enum": [
            "none",
            "daily",
            "weekdays",
            "weekly"
          ],
          "default": "none"
        },
        "completed": {
          "type": "boolean"
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "nextTaskId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reminderTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "default": null
        },
        "focusMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 180,
          "default": null
        },
        "reminderFired": {
          "type": "boolean",
          "default": false
        },
        "reminderPending": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "reminderTime"
            ],
            "properties": {
              "reminderTime": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "dueDate"
            ],
            "properties": {
              "dueDate": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "subtask": {
      "type": "object",
      "required": [
        "id",
        "title",
        "done"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "focusMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "shortBreakMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "longBreakMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "longBreakEvery": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "dailyGoal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "autoBreak": {
          "type": "boolean"
        },
        "autoFocus": {
          "type": "boolean"
        },
        "sound": {
          "type": "boolean"
        },
        "notifications": {
          "type": "boolean"
        },
        "alwaysOnTop": {
          "type": "boolean"
        },
        "theme": {
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "protection": {
          "$ref": "#/$defs/protection"
        }
      },
      "required": [
        "focusMinutes",
        "shortBreakMinutes",
        "longBreakMinutes",
        "longBreakEvery",
        "dailyGoal",
        "autoBreak",
        "autoFocus",
        "sound",
        "notifications",
        "alwaysOnTop",
        "theme"
      ]
    },
    "protection": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "lock",
            "whitelist"
          ]
        },
        "whitelist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 100
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "timer": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "focus",
            "shortBreak",
            "longBreak"
          ]
        },
        "running": {
          "type": "boolean"
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationSecs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10800
        },
        "remainingSecs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10800
        },
        "deadline": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "completionSerial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "lastFinishedMode": {
          "anyOf": [
            {
              "enum": [
                "focus",
                "shortBreak",
                "longBreak"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "running",
        "durationSecs",
        "remainingSecs",
        "cycle",
        "completionSerial"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskTitle": {
          "type": "string",
          "maxLength": 200
        },
        "projectName": {
          "type": "string",
          "maxLength": 40
        },
        "startedAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "endedAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "durationSecs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10800
        },
        "completed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "taskTitle",
        "projectName",
        "startedAt",
        "endedAt",
        "durationSecs",
        "completed"
      ]
    },
    "lock": {
      "type": "object",
      "properties": {
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockSchedule"
          },
          "maxItems": 20
        },
        "active": {
          "anyOf": [
            {
              "$ref": "#/$defs/activeLock"
            },
            {
              "type": "null"
            }
          ]
        },
        "suppressedUntil": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      },
      "required": []
    },
    "lockSchedule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        },
        "enabled": {
          "type": "boolean"
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "start",
        "end",
        "days",
        "enabled"
      ],
      "additionalProperties": false
    },
    "activeLock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "startedAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "endsAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "startedAt",
        "endsAt",
        "strict"
      ]
    }
  }
}
