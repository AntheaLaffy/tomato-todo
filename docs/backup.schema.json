{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tomato Todo Backup v4",
  "type": "object",
  "properties": {
    "version": {
      "const": 4
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "maxItems": 500
    },
    "habits": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/habit"
      }
    },
    "blocks": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "visions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vision"
      },
      "maxItems": 500
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "maxItems": 50000
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "timer": {
      "$ref": "#/$defs/timer"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      },
      "maxItems": 200000
    },
    "lock": {
      "$ref": "#/$defs/lock"
    },
    "templates": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "prints": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "$ref": "#/$defs/print"
      }
    },
    "identities": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/identity"
      },
      "default": []
    },
    "education": {
      "$ref": "#/$defs/educationEducation"
    }
  },
  "required": [
    "version",
    "projects",
    "tasks",
    "settings",
    "timer",
    "sessions"
  ],
  "$defs": {
    "vision": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 50000
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "habit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "days",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "attention": {
          "enum": [
            "required",
            "light"
          ],
          "default": "required"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "appWhitelist": {
          "type": "array",
          "maxItems": 100,
          "description": "该项目启用的专属白名单，精确匹配，最多 100 个；专注该项目任务时替代通用白名单。",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "notes",
        "priority",
        "estimate",
        "completed",
        "createdAt",
        "tags",
        "subtasks",
        "dueDate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "description": "Rust additionally limits UTF-8 bytes to 50000."
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "habitId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "dueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "subtasks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/subtask"
          }
        },
        "completed": {
          "type": "boolean"
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "reminderTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "default": null
        },
        "focusMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 180,
          "default": null
        },
        "reminderFired": {
          "type": "boolean",
          "default": false
        },
        "reminderPending": {
          "type": "boolean",
          "default": false
        },
        "templateId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recurring": {
          "type": "boolean",
          "default": false
        },
        "scrapMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080,
          "default": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "reminderTime"
            ],
            "properties": {
              "reminderTime": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "dueDate"
            ],
            "properties": {
              "dueDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "format": "date"
              }
            }
          }
        }
      ]
    },
    "subtask": {
      "type": "object",
      "required": [
        "id",
        "title",
        "done"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "done": {
          "type": "boolean"
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "focusMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "shortBreakMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "longBreakMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "longBreakEvery": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "dailyGoal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "autoBreak": {
          "type": "boolean"
        },
        "autoFocus": {
          "type": "boolean"
        },
        "sound": {
          "type": "boolean"
        },
        "notifications": {
          "type": "boolean"
        },
        "alwaysOnTop": {
          "type": "boolean"
        },
        "theme": {
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "personaBackdrop": {
          "type": "boolean",
          "default": false
        },
        "protection": {
          "$ref": "#/$defs/protection"
        },
        "soundVolume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 100
        }
      },
      "required": [
        "focusMinutes",
        "shortBreakMinutes",
        "longBreakMinutes",
        "longBreakEvery",
        "dailyGoal",
        "autoBreak",
        "autoFocus",
        "sound",
        "notifications",
        "alwaysOnTop",
        "theme"
      ]
    },
    "protection": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "lock",
            "whitelist"
          ]
        },
        "whitelist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32768
          },
          "maxItems": 100
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "timer": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "focus",
            "shortBreak",
            "longBreak"
          ]
        },
        "running": {
          "type": "boolean"
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "durationSecs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10800
        },
        "remainingSecs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10800
        },
        "deadline": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "cycleDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completionSerial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "lastFinishedMode": {
          "anyOf": [
            {
              "enum": [
                "focus",
                "shortBreak",
                "longBreak"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "running",
        "durationSecs",
        "remainingSecs",
        "cycle",
        "completionSerial"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "taskTitle": {
          "type": "string",
          "maxLength": 200
        },
        "projectName": {
          "type": "string",
          "maxLength": 40
        },
        "startedAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "endedAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "durationSecs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1069200,
          "description": "timer 为实际专注秒数（最多 10800）；taskEstimate 为按预计补足的差额（最多 99 × 180 × 60）"
        },
        "completed": {
          "type": "boolean",
          "description": "番茄到时或用户提前完成为 true；不表示任务已完成"
        },
        "source": {
          "enum": [
            "timer",
            "taskEstimate"
          ],
          "default": "timer",
          "description": "timer 为实际计时；taskEstimate 为完成任务时按预计用时补足的差额，缺省 timer"
        }
      },
      "required": [
        "id",
        "taskTitle",
        "projectName",
        "startedAt",
        "endedAt",
        "durationSecs",
        "completed"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "const": "taskEstimate"
              }
            }
          },
          "then": {
            "required": [
              "taskId"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "completed": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "durationSecs": {
                "maximum": 10800
              }
            }
          }
        }
      ]
    },
    "lock": {
      "type": "object",
      "properties": {
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockSchedule"
          },
          "maxItems": 20
        },
        "active": {
          "anyOf": [
            {
              "$ref": "#/$defs/activeLock"
            },
            {
              "type": "null"
            }
          ]
        },
        "suppressedUntil": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      },
      "required": []
    },
    "lockSchedule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        },
        "enabled": {
          "type": "boolean"
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "start",
        "end",
        "days",
        "enabled"
      ],
      "additionalProperties": false
    },
    "activeLock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S"
        },
        "startedAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "endsAt": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        "strict": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "startedAt",
        "endsAt",
        "strict"
      ]
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "maxLength": 50000,
          "description": "Rust additionally limits UTF-8 bytes to 50000."
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        },
        "estimate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 1
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "subtasks": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/templateSubtask"
          }
        },
        "focusMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 180,
          "default": null
        },
        "habitId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scrapMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080,
          "default": 0
        }
      }
    },
    "printing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "date"
          ],
          "properties": {
            "kind": {
              "const": "once"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            },
            "time": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
              "default": null
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "slots"
          ],
          "properties": {
            "kind": {
              "const": "calendar"
            },
            "slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 49,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dates"
                ],
                "properties": {
                  "dates": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 366,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                    "default": null
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "slots"
          ],
          "properties": {
            "kind": {
              "const": "weekly"
            },
            "slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 49,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "days"
                ],
                "properties": {
                  "days": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 7
                    }
                  },
                  "time": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                    "default": null
                  }
                }
              }
            }
          }
        }
      ]
    },
    "print": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "date"
      ],
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shape",
        "printing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "printing": {
          "$ref": "#/$defs/printing"
        },
        "automatic": {
          "type": "boolean",
          "default": false
        },
        "printAheadDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90,
          "default": 7
        }
      }
    },
    "templateSubtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
