{
  "name": "tomato-todo-rewrite",
  "version": "0.12.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "core:test": "pnpm --filter @tomato/core test",
    "runtime:test": "node --test runtime/test/",
    "build:runtime": "node scripts/build-runtime.mjs",
    "format": "prettier --write \"packages/**/*.ts\" \"runtime/**/*.{ts,mjs}\" \"plugin/**/*.{js,json,yml}\" scripts tests",
    "check": "pnpm core:test && pnpm runtime:test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "lucide": "^1.53.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*",
    "runtime",
    "plugin"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "description": "番茄 Todo 重写：DSH 插件 + Node runtime + 原生守卫"
}
