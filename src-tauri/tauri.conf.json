{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tomato Todo",
  "version": "0.6.1",
  "identifier": "studio.tomato.todo",
  "build": {
    "beforeDevCommand": "pnpm run dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "\u756a\u8304 Todo",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "backgroundColor": "#faf8f4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Productivity",
    "linux": {
      "deb": {
        "desktopTemplate": "tomato.desktop.hbs"
      }
    },
    "shortDescription": "\u4efb\u52a1\u4e0e\u756a\u8304\u949f\uff0c\u4e00\u4e2a\u5b89\u9759\u7684\u4e13\u6ce8\u7a7a\u95f4",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "../agent/bundle/": "agent/"
    }
  }
}
